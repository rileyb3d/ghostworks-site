# Ghostworks env vars. Copy to .env.local and fill in. Never commit .env.local.
# Mirror every new key here so the contract is obvious to the next agent / human.

# --- App ---
# Used for redirect URLs in Stripe / Clerk / email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Clerk (auth) ---
# https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Webhook signing secret for /api/webhooks/clerk (Clerk dashboard -> Webhooks).
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx
# Optional: only set if using a custom auth proxy domain.
# NEXT_PUBLIC_CLERK_PROXY_URL=

# --- Resend (transactional email) ---
# https://resend.com -> API Keys. Domain must be verified.
RESEND_API_KEY=re_xxx
# From / to addresses for the contact form.
CONTACT_FROM_EMAIL=hello@ghostworks.example
CONTACT_TO_EMAIL=hello@ghostworks.example

# --- Cloudflare Turnstile (bot protection on public forms) ---
# https://dash.cloudflare.com -> Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA_site_key
TURNSTILE_SECRET_KEY=0x4AAAAAAA_secret_key

# --- Stripe (client invoice payments) ---
# https://dashboard.stripe.com -> Developers -> API keys
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Webhook signing secret for /api/webhooks/stripe (Stripe dashboard -> Webhooks).
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Vercel Blob (CDN for project assets / uploads) ---
# Vercel dashboard -> Storage -> Blob -> .env tab
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
